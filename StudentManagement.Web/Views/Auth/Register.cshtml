@model StudentManagement.Services.ViewModels.Auth.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <title>UBYS — Kayıt Ol</title>
    <link rel="icon" type="image/png" href="~/images/logo.png?v=4" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Register'e özel premium UI overrides */
        body { margin: 0; padding: 0; overflow: hidden; height: 100vh; }
        .auth-wrapper { height: 100vh; overflow: hidden; }
        .auth-left {
            flex: 1.2 !important;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }
        .auth-right {
            flex: 1 !important;
            max-width: 650px;
            min-width: 480px;
            padding: 40px 60px !important;
            background: #ffffff;
            position: relative;
            z-index: 5;
            box-shadow: -20px 0 50px rgba(0,0,0,0.05);
            display: flex; flex-direction: column; justify-content: center;
            overflow-y: auto;
        }
        
        @@media (max-width: 1024px) {
            .auth-left { display: none !important; }
            .auth-right {
                flex: none !important;
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
                padding: 40px 24px !important;
                box-shadow: none !important;
            }
        }
        .auth-form-title { font-size: 1.8rem; font-weight: 800; color: #1e293b; letter-spacing: -0.5px; }
        .auth-form-subtitle { color: #64748b; font-size: 0.95rem; margin-top: 4px; }
        
        .form-label { font-weight: 700; color: #334155; font-size: 0.85rem; margin-bottom: 8px; display: block; }
        .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            color: #0f172a;
            transition: all 0.3s ease;
            background: #f8fafc;
        }
        .form-control:focus {
            background: #ffffff;
            border-color: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
        }
        .input-icon > i {
            position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
            color: #94a3b8; font-size: 1rem; pointer-events: none;
            transition: all 0.3s ease;
        }
        .form-control:focus + i, .input-icon:focus-within > i { color: #38bdf8; }
        .input-icon .form-control { padding-left: 44px; }
        
        .input-icon .toggle-pass {
            position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #94a3b8; cursor: pointer; padding: 0; font-size: 1.1rem; transition: color 0.3s ease;
            outline: none; z-index: 10; display: flex; align-items: center; justify-content: center;
        }
        .input-icon .toggle-pass:hover { color: #334155; }
        .input-icon .form-control.has-toggle { padding-right: 48px; }

        .btn-primary {
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-size: 1rem;
            font-weight: 700;
            color: white;
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3);
            transition: all 0.3s ease;
            width: 100%;
            display: flex; justify-content: center; align-items: center; gap: 8px;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(2, 132, 199, 0.4);
            background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);
        }
        
        .auth-divider { color: #94a3b8; font-size: 0.8rem; font-weight: 700; margin: 30px 0; text-transform: uppercase; letter-spacing: 1px; text-align: center; position: relative; }
        .auth-divider::before, .auth-divider::after { content: ''; position: absolute; top: 50%; width: calc(50% - 30px); height: 1px; background: #e2e8f0; }
        .auth-divider::before { left: 0; } .auth-divider::after { right: 0; }
        
        .btn-outline-secondary { border: 2px solid #e2e8f0; color: #475569; border-radius: 12px; padding: 12px; font-weight: 700; transition: all 0.3s ease; display: block; text-align: center; }
        .btn-outline-secondary:hover { background: #f8fafc; border-color: #cbd5e1; color: #1e293b; }
        
        /* Şifre güç göstergesi */
        .pass-strength { display:flex; gap:4px; margin-top:8px; }
        .pass-strength-bar { flex:1; height:3px; border-radius:10px; background:var(--color-gray-200); transition:.3s; }
        .pass-strength-bar.active-weak   { background:var(--color-danger); }
        .pass-strength-bar.active-medium { background:var(--color-warning); }
        .pass-strength-bar.active-strong { background:var(--color-success); }
        .pass-strength-label { font-size:.7rem; color:var(--color-gray-400); margin-top:4px; font-weight:600; }
        /* Scroll */
        .auth-right { overflow-y: auto; }
        
        .auth-logo img {
            max-width: 150px;
            height: auto;
            object-fit: contain;
            margin-bottom: 20px;
        }
    </style>
</head>
<body data-role="ogrenci">

<div class="auth-wrapper">


    <div class="auth-left" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        

        <div style="background: rgba(255,255,255,0.95); padding: 15px 30px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); margin-bottom: 25px; border: 1px solid rgba(255,255,255,0.2); backdrop-filter: blur(10px); position: relative; z-index: 10;">
            <img src="~/images/logo.png?v=4" alt="UBYS Logo" style="max-width: 170px; height: auto; object-fit: contain; display: block;" />
        </div>

        <div class="auth-tagline" style="text-align: center; position: relative; z-index: 10;">
            <h1 style="color: #ffffff; font-size: 2rem; font-weight: 800; line-height: 1.3; margin-bottom: 12px; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">
                Öğrenci Yönetim<br><span style="color: #38bdf8;">Sistemi</span>
            </h1>
            <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; max-width: 320px; margin: 0 auto;">
                Akademik kariyerinize başlamak için yeni bir hesap oluşturun.
            </p>
        </div>

        <div class="auth-features" style="margin-top: 40px; display: flex; flex-direction: column; gap: 12px; position: relative; z-index: 10; width: 100%; max-width: 340px;">
            <div style="display: flex; align-items: center; gap: 15px; padding: 14px 20px; background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(5px);">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(56, 189, 248, 0.2); display: flex; align-items: center; justify-content: center; color: #38bdf8; font-size: 1.1rem;"><i class="fas fa-book-open"></i></div>
                <span style="color: #e2e8f0; font-size: 0.9rem; font-weight: 600;">Ders Kayıt &amp; Takip</span>
            </div>
            <div style="display: flex; align-items: center; gap: 15px; padding: 14px 20px; background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(5px);">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(16, 185, 129, 0.2); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 1.1rem;"><i class="fas fa-chart-line"></i></div>
                <span style="color: #e2e8f0; font-size: 0.9rem; font-weight: 600;">Not ve GANO Hesaplama</span>
            </div>
            <div style="display: flex; align-items: center; gap: 15px; padding: 14px 20px; background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(5px);">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(245, 158, 11, 0.2); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 1.1rem;"><i class="fas fa-calendar-check"></i></div>
                <span style="color: #e2e8f0; font-size: 0.9rem; font-weight: 600;">Yoklama ve Sınav Takvimi</span>
            </div>
            <div style="display: flex; align-items: center; gap: 15px; padding: 14px 20px; background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(5px);">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(139, 92, 246, 0.2); display: flex; align-items: center; justify-content: center; color: #8b5cf6; font-size: 1.1rem;"><i class="fas fa-file-alt"></i></div>
                <span style="color: #e2e8f0; font-size: 0.9rem; font-weight: 600;">Online Belge Talepleri</span>
            </div>
        </div>
    </div>


    <div class="auth-right">

        <div class="auth-form-header">
            <h2 class="auth-form-title">Hesap Oluştur</h2>
            <p class="auth-form-subtitle">Tüm alanları doldurun, hesabınız hemen aktif edilsin.</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <div class="alert-body">
                    <div class="alert-title">Lütfen hataları düzeltin</div>
                    <div asp-validation-summary="ModelOnly" class="alert-text"></div>
                </div>
            </div>
        }

        <form asp-action="Register" asp-controller="Auth" method="post" id="registerForm" novalidate>
            @Html.AntiForgeryToken()


            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Ad" class="form-label">Ad <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="fas fa-user icon"></i>
                        <input asp-for="Ad" class="form-control" placeholder="Adınız" autocomplete="given-name" />
                    </div>
                    <span asp-validation-for="Ad" class="invalid-feedback"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Soyad" class="form-label">Soyad <span class="required">*</span></label>
                    <div class="input-icon">
                        <i class="fas fa-user icon"></i>
                        <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" autocomplete="family-name" />
                    </div>
                    <span asp-validation-for="Soyad" class="invalid-feedback"></span>
                </div>
            </div>


            <div class="form-group">
                <label asp-for="KullaniciAdi" class="form-label">
                    Kullanıcı Adı <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="fas fa-at icon"></i>
                    <input asp-for="KullaniciAdi" class="form-control"
                           placeholder="kullanici.adi"
                           autocomplete="username" autofocus />
                </div>
                <span asp-validation-for="KullaniciAdi" class="invalid-feedback"></span>
                <div class="form-text">Harf, rakam, nokta ve alt çizgi kullanabilirsiniz.</div>
            </div>


            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    E-posta <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="fas fa-envelope icon"></i>
                    <input asp-for="Email" class="form-control" type="email"
                           placeholder="ornek@universite.edu.tr"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="invalid-feedback"></span>
            </div>


            <div class="form-group">
                <label asp-for="BolumId" class="form-label">
                    Bölüm <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="fas fa-building-columns icon"></i>
                    <select asp-for="BolumId" class="form-control"
                            asp-items="ViewBag.Bolumler">
                        <option value="">— Bölüm seçiniz —</option>
                    </select>
                </div>
                <span asp-validation-for="BolumId" class="invalid-feedback"></span>
            </div>


            <div class="form-group">
                <label asp-for="Sifre" class="form-label">
                    Şifre <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="fas fa-lock icon"></i>
                    <input asp-for="Sifre" type="password" class="form-control has-toggle"
                           placeholder="Min. 8 karakter"
                           autocomplete="new-password"
                           id="sifreInput"
                           oninput="SMS.auth.checkPasswordStrength(this.value)" />
                    <button type="button" class="toggle-pass"
                            onclick="SMS.auth.togglePassword('sifreInput','passEye1')">
                        <i class="fas fa-eye" id="passEye1"></i>
                    </button>
                </div>

                <div class="pass-strength" id="passStrength">
                    <div class="pass-strength-bar" id="bar1"></div>
                    <div class="pass-strength-bar" id="bar2"></div>
                    <div class="pass-strength-bar" id="bar3"></div>
                    <div class="pass-strength-bar" id="bar4"></div>
                </div>
                <div class="pass-strength-label" id="passLabel"></div>
                <span asp-validation-for="Sifre" class="invalid-feedback"></span>
            </div>


            <div class="form-group">
                <label asp-for="SifreTekrar" class="form-label">
                    Şifre Tekrar <span class="required">*</span>
                </label>
                <div class="input-icon">
                    <i class="fas fa-lock icon"></i>
                    <input asp-for="SifreTekrar" type="password" class="form-control has-toggle"
                           placeholder="Şifreyi tekrar girin"
                           autocomplete="new-password"
                           id="sifreTekrarInput" />
                    <button type="button" class="toggle-pass"
                            onclick="SMS.auth.togglePassword('sifreTekrarInput','passEye2')">
                        <i class="fas fa-eye" id="passEye2"></i>
                    </button>
                </div>
                <span asp-validation-for="SifreTekrar" class="invalid-feedback"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" id="registerBtn">
                <i class="fas fa-user-plus"></i>
                Hesap Oluştur
            </button>
        </form>

        <div class="auth-divider">zaten hesabınız var mı?</div>

        <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-secondary w-100">
            <i class="fas fa-sign-in-alt"></i>
            Giriş Yap
        </a>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<partial name="_ValidationScriptsPartial" />

<script>
    SMS.auth = {
        togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const eye   = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                eye.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                eye.classList.replace("fa-eye-slash", "fa-eye");
            }
        },

        checkPasswordStrength(val) {
            const bars  = [1,2,3,4].map(i => document.getElementById("bar" + i));
            const label = document.getElementById("passLabel");
            let score = 0;

            if (val.length >= 8)           score++;
            if (/[A-Z]/.test(val))         score++;
            if (/[0-9]/.test(val))         score++;
            if (/[^A-Za-z0-9]/.test(val))  score++;

            bars.forEach((b, i) => {
                b.className = "pass-strength-bar";
                if (i < score) {
                    if (score <= 1)      b.classList.add("active-weak");
                    else if (score <= 2) b.classList.add("active-medium");
                    else                 b.classList.add("active-strong");
                }
            });

            const labels = ["", "Zayıf", "Orta", "İyi", "Güçlü"];
            const colors = ["", "#ef4444", "#f59e0b", "#10b981", "#10b981"];
            label.textContent = val ? labels[score] || "Güçlü" : "";
            label.style.color = colors[score] || "#10b981";
        },
    };

    document.getElementById("registerForm").addEventListener("submit", function () {
        SMS.form.setLoading(this, true);
    });
</script>
</body>
</html>
